{
  "name": "api-contract-intelligence-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server that connects OpenAPI changes to TypeScript openapi-fetch consumers.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
